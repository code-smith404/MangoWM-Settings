# Maintainer: Harikesh Verma <code-smith404@users.noreply.github.com>
pkgname=mango-settings
pkgver=2.4.0
pkgrel=1
pkgdesc="GTK3 settings manager for the MangoWM Wayland compositor"
arch=('any')
url="https://github.com/code-smith404/MangoWM-Settings"
license=('MIT')
depends=('python' 'python-gobject' 'gtk3')
optdepends=(
    'mmsg: reload MangoWM and detect connected monitors from within the app'
    'swaybg: set the wallpaper from the Background page'
    'swww: set animated wallpapers from the Background page'
    'feh: set the wallpaper on X11 sessions'
)
makedepends=('make')
checkdepends=('python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b8c3cff9a0c60f727feaa1c622668729d0c0e02b6e1030b94860448d5d5465d6')

check() {
    cd "$srcdir/MangoWM-Settings-$pkgver"
    python -m py_compile mango-settings.py
    python -m unittest discover -s tests -v
    python mango-settings.py --list-pages >/dev/null
}

package() {
    cd "$srcdir/MangoWM-Settings-$pkgver"
    make install DESTDIR="$pkgdir" PREFIX=/usr
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
