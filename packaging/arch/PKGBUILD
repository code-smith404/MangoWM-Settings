# Maintainer: Harikesh Verma <code-smith404@users.noreply.github.com>
pkgname=mango-settings
pkgver=2.2.0
pkgrel=1
pkgdesc="GTK3 settings manager for the MangoWM Wayland compositor"
arch=('any')
url="https://github.com/code-smith404/MangoWM-Settings"
license=('MIT')
depends=('python-gobject' 'gtk3' 'python')
optdepends=('mmsg: reload MangoWM and detect monitors from within the app')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/MangoWM-Settings-$pkgver"
    local prefix="$pkgdir/usr"
    install -d "$prefix/bin" "$prefix/share/mango-settings" \
        "$prefix/share/applications" \
        "$prefix/share/icons/hicolor/scalable/apps" \
        "$prefix/share/licenses/$pkgname"
    install -m 755 mango-settings.py "$prefix/share/mango-settings/"
    printf '#!/bin/sh\nexec python3 "%s/share/mango-settings/mango-settings.py" "$@"\n' \
        "$prefix" > "$pkgdir/usr/bin/mango-settings"
    sed -i "s|$prefix||g" "$pkgdir/usr/bin/mango-settings"
    chmod +x "$pkgdir/usr/bin/mango-settings"
    install -m 644 data/io.github.code_smith404.MangoSettings.desktop \
        "$prefix/share/applications/"
    install -m 644 data/io.github.code_smith404.MangoSettings.svg \
        "$prefix/share/icons/hicolor/scalable/apps/"
    install -m 644 LICENSE "$prefix/share/licenses/$pkgname/"
}
